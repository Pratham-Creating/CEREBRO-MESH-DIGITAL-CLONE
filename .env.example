# MySQL connection. Create the database before starting the application.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=activity_tracker
MYSQL_USER=activity_app
MYSQL_PASSWORD=change-me

PORT=3210
POLL_INTERVAL_MS=2000

# Semicolon-separated folders to watch. Leave blank to disable file tracking.
# Example: C:\\Users\\you\\Documents;C:\\Users\\you\\Desktop
WATCH_PATHS=

# Clipboard options: none | metadata | text
# metadata records type, length and a one-way fingerprint; it never saves clipboard text.
CLIPBOARD_CAPTURE=metadata

# Exclude these process names from window-title and clipboard collection.
EXCLUDED_PROCESS_NAMES=KeePass.exe;1Password.exe;Bitwarden.exe
